{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "models-updater",
  "main": "workers/update-models.ts",
  "compatibility_date": "2026-01-09",
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "r2_buckets": [
    {
      "binding": "MODELS_BUCKET",
      "bucket_name": "eztoolab"
    }
  ]
}
